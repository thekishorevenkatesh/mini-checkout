PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/vendor_mvp
JWT_SECRET=replace_with_long_random_secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Nodemailer (Email OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_email_password_or_app_password

# ─── Razorpay (Direct vendor settlement via Route) ───────────────────────────
# Platform Razorpay account keys — https://dashboard.razorpay.com → Settings → API Keys
# Route must be enabled; each approved vendor gets a linked account (created on admin approval).
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Webhook secret — Razorpay Dashboard → Webhooks → your endpoint → Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Local dev without Razorpay: omit keys or use mock id (mock client skips signature checks)
# RAZORPAY_KEY_ID=rzp_test_mock_id
# RAZORPAY_KEY_SECRET=mock_secret

# Settlement model: on payment.captured, full sub-order amount (items + delivery) is
# transferred immediately to the vendor linked account (on_hold=0). No platform
# commission is deducted on new orders. Delivery status does not gate payouts.

# ─── KYC Encryption ──────────────────────────────────────────────────────────
# AES-256-GCM key for vendor PAN and bank details at rest.
# MUST be exactly 64 hex characters (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FINANCIAL_ENCRYPTION_KEY=replace_with_64_hex_character_key_generated_above

# ─── Cloudinary (optional — product images) ──────────────────────────────────
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ─── Razorpay webhook setup ──────────────────────────────────────────────────
# Register ONE of these URLs in Razorpay Dashboard → Webhooks (both routes use the same handler):
#   https://yourdomain.com/api/payments/webhook
#   https://yourdomain.com/api/webhooks/webhook
#
# Recommended events:
#   payment.captured      — mark order paid + create immediate Route transfer to vendor
#   payment.failed        — cancel sub-orders
#   transfer.processed    — sync transferStatus on sub-order
#   transfer.failed       — mark failed transfers for retry
#   refund.processed      — ledger debits + order cancellation
#   account.activated     — enable vendor payoutStatus when linked account goes live
#   account.updated       — sync linked account suspension / activation
#   settlement.processed  — optional (logged; bank settlement is handled by Razorpay)
#
# Vendor linked account onboarding (admin approval trigger):
#   POST /v2/accounts -> stakeholder -> Route product request -> bank settlement update
# Backfill approved vendors missing linked accounts:
#   npm run backfill:linked-accounts
#
# Optional defaults when vendor address has no 6-digit PIN:
# RAZORPAY_DEFAULT_CITY=Mumbai
# RAZORPAY_DEFAULT_STATE=MH
# RAZORPAY_DEFAULT_POSTAL_CODE=400001
