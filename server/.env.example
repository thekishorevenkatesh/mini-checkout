PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/vendor_mvp
JWT_SECRET=replace_with_long_random_secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Nodemailer (Email OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_email_password_or_app_password

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Webhook secret — set in Razorpay Dashboard → Webhooks → your endpoint → Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Platform fee charged to vendors per order (percentage, e.g. 2 = 2%)
PLATFORM_FEE_PERCENT=2

# ─── KYC Encryption ──────────────────────────────────────────────────────────
# AES-256-GCM key used to encrypt vendor PAN and bank details at rest.
# MUST be exactly 64 hex characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FINANCIAL_ENCRYPTION_KEY=replace_with_64_hex_character_key_generated_above

# ─── Cloudinary (Product Images) ─────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ─── Notes ───────────────────────────────────────────────────────────────────
# Register your webhook URL in Razorpay Dashboard → Webhooks:
#   https://yourdomain.com/api/webhooks/razorpay
#   Events: payment.captured, payment.failed
